<?xml version="1.0" encoding="UTF-8"?>
<plannerBenchmark xmlns="https://timefold.ai/xsd/benchmark">
  <!--
    Move Selector Effectiveness Benchmark
    Measures per-move-type statistics to determine which move types contribute
    to score improvement and which waste CPU cycles.

    Key metrics:
    - PICKED_MOVE_TYPE_BEST_SCORE_DIFF: which moves improved best score and by how much
    - PICKED_MOVE_TYPE_STEP_SCORE_DIFF: which moves improved step score
    - MOVE_COUNT_PER_TYPE: how many moves evaluated per type
    - MOVE_COUNT_PER_STEP: accepted/selected per step
  -->

  <benchmarkDirectory>local/benchmarkMoveStats</benchmarkDirectory>

  <inheritedSolverBenchmark>
    <solver>
      <solutionClass>com.school.planner.domain.SchoolSchedule</solutionClass>
      <entityClass>com.school.planner.domain.Lesson</entityClass>
      <scoreDirectorFactory>
        <constraintProviderClass>com.school.planner.solver.SchoolScheduleConstraintProvider</constraintProviderClass>
        <initializingScoreTrend>ONLY_DOWN</initializingScoreTrend>
      </scoreDirectorFactory>
      <termination>
        <secondsSpentLimit>900</secondsSpentLimit>
        <unimprovedSecondsSpentLimit>180</unimprovedSecondsSpentLimit>
      </termination>
      <constructionHeuristic>
        <constructionHeuristicType>FIRST_FIT</constructionHeuristicType>
      </constructionHeuristic>
    </solver>
    <problemBenchmarks>
      <solutionFileIOClass>com.school.planner.benchmark.SchoolScheduleSolutionFileIO</solutionFileIOClass>
      <inputSolutionFile>local/data/schedule-production.json</inputSolutionFile>
      <!-- Move-level statistics for effectiveness analysis -->
      <problemStatisticType>MOVE_COUNT_PER_TYPE</problemStatisticType>
      <problemStatisticType>MOVE_COUNT_PER_STEP</problemStatisticType>
      <singleStatisticType>PICKED_MOVE_TYPE_BEST_SCORE_DIFF</singleStatisticType>
      <singleStatisticType>PICKED_MOVE_TYPE_STEP_SCORE_DIFF</singleStatisticType>
    </problemBenchmarks>
  </inheritedSolverBenchmark>

  <!-- ========================================================================
       Phase 3 Production Config — Tabu entityTabuSize=7
       Move weights match solverConfig.xml exactly:
         change(timeslot) 5.0, swap(timeslot) 3.0,
         pillarChange(timeslot) 2.0, pillarSwap(timeslot) 1.0
       ======================================================================== -->
  <solverBenchmark>
    <name>Phase3-Tabu-EntitySize7-MoveStats</name>
    <solver>
      <environmentMode>NON_REPRODUCIBLE</environmentMode>
      <localSearch>
        <unionMoveSelector>
          <!-- changeMoveSelector: timeslot — primary compactness lever (weight 5.0) -->
          <changeMoveSelector>
            <fixedProbabilityWeight>5.0</fixedProbabilityWeight>
            <entitySelector>
              <entityClass>com.school.planner.domain.Lesson</entityClass>
            </entitySelector>
            <valueSelector variableName="timeslot"/>
          </changeMoveSelector>

          <!-- swapMoveSelector: timeslot — conflict resolution by exchange (weight 3.0) -->
          <swapMoveSelector>
            <fixedProbabilityWeight>3.0</fixedProbabilityWeight>
            <entitySelector>
              <entityClass>com.school.planner.domain.Lesson</entityClass>
            </entitySelector>
            <secondaryEntitySelector>
              <entityClass>com.school.planner.domain.Lesson</entityClass>
            </secondaryEntitySelector>
            <variableNameIncludes>
              <variableNameInclude>timeslot</variableNameInclude>
            </variableNameIncludes>
          </swapMoveSelector>

          <!-- pillarChangeMoveSelector: timeslot — preserve consecutive patterns (weight 2.0) -->
          <pillarChangeMoveSelector>
            <fixedProbabilityWeight>2.0</fixedProbabilityWeight>
            <pillarSelector>
              <entitySelector>
                <entityClass>com.school.planner.domain.Lesson</entityClass>
              </entitySelector>
            </pillarSelector>
            <valueSelector variableName="timeslot"/>
          </pillarChangeMoveSelector>

          <!-- pillarSwapMoveSelector: timeslot — exchange entire timeslot schedules (weight 1.0) -->
          <pillarSwapMoveSelector>
            <fixedProbabilityWeight>1.0</fixedProbabilityWeight>
            <pillarSelector>
              <entitySelector>
                <entityClass>com.school.planner.domain.Lesson</entityClass>
              </entitySelector>
            </pillarSelector>
            <variableNameIncludes>
              <variableNameInclude>timeslot</variableNameInclude>
            </variableNameIncludes>
          </pillarSwapMoveSelector>
        </unionMoveSelector>
        <acceptor>
          <entityTabuSize>7</entityTabuSize>
        </acceptor>
        <forager>
          <acceptedCountLimit>1000</acceptedCountLimit>
        </forager>
      </localSearch>
    </solver>
  </solverBenchmark>

</plannerBenchmark>
