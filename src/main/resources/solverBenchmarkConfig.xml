<?xml version="1.0" encoding="UTF-8"?>
<plannerBenchmark xmlns="https://timefold.ai/xsd/benchmark">
  <!--
    Local Search Algorithm Comparison Benchmark

    Comprehensive comparison of Timefold local search algorithms based on
    exhaustive research from Timefold documentation (2026-03-18).

    Research report: claudedocs/research_local_search_and_school_timetabling_20260318.md

    Algorithms tested (15 configs; trimmed from 23 in TASK-283):
    1. Tabu Search - Entity Tabu (size + ratio variants) - baseline recommended
    2. Tabu Search - Strategic Oscillation (3 threshold variants)
    3. Tabu Search - Composite Tabu
    4. Late Acceptance (size variations)
    5. Diversified Late Acceptance (preview feature)
    6. Step Counting Hill Climbing
    7. Variable Neighborhood Descent

    Removed in TASK-283 (data-based: the 2026-03-20 23-config run showed them
    systematically underperforming VND/Tabu): Simulated Annealing (random-walk
    acceptance, hard -89/-97 worst), Great Deluge (medium -400k+), Property/Value
    Tabu (no score produced).
    Excluded: Pure Hill Climbing (DISCOURAGED - gets stuck in local optima).
  -->

  <benchmarkDirectory>local/benchmarkReport</benchmarkDirectory>

  <!-- ========================================================================
       INHERITED CONFIGURATION
       Common settings shared across all solver benchmarks
       ======================================================================== -->
  <inheritedSolverBenchmark>
    <solver>
      <solutionClass>com.school.planner.domain.SchoolSchedule</solutionClass>
      <entityClass>com.school.planner.domain.Lesson</entityClass>
      <scoreDirectorFactory>
        <constraintProviderClass>com.school.planner.solver.SchoolScheduleConstraintProvider</constraintProviderClass>
        <initializingScoreTrend>ONLY_DOWN</initializingScoreTrend>
      </scoreDirectorFactory>
      <!-- Termination for both CH and LS phases -->
      <!-- Doubled from 900/180 (task-273): M22 hard + M20 quota increase
           require more optimization time per config. -->
      <termination>
        <secondsSpentLimit>1800</secondsSpentLimit>
        <unimprovedSecondsSpentLimit>600</unimprovedSecondsSpentLimit>
      </termination>
      <!-- Construction Heuristic: common initialization for all solvers -->
      <constructionHeuristic>
        <constructionHeuristicType>FIRST_FIT</constructionHeuristicType>
      </constructionHeuristic>
      <!-- Local Search: each solver defines complete localSearch with move selectors + acceptor/forager -->
    </solver>
    <problemBenchmarks>
      <solutionFileIOClass>com.school.planner.benchmark.SchoolScheduleSolutionFileIO</solutionFileIOClass>
      <inputSolutionFile>local/data/schedule-production.json</inputSolutionFile>
    </problemBenchmarks>
  </inheritedSolverBenchmark>

  <!-- ========================================================================
       BASELINE: Tabu Search (Entity Tabu) - RECOMMENDED
       Move selectors are inherited from inheritedSolverBenchmark
       ======================================================================== -->

  <!-- Tabu #1: Entity tabu size 5 -->
  <solverBenchmark>
    <name>Tabu-Entity-Size5</name>
    <solver>
      <environmentMode>NON_REPRODUCIBLE</environmentMode>
      <localSearch>
        <unionMoveSelector>
          <changeMoveSelector>
            <fixedProbabilityWeight>5.0</fixedProbabilityWeight>
            <entitySelector>
              <entityClass>com.school.planner.domain.Lesson</entityClass>
            </entitySelector>
            <valueSelector variableName="timeslot"/>
          </changeMoveSelector>
          <pillarChangeMoveSelector>
            <fixedProbabilityWeight>2.0</fixedProbabilityWeight>
            <pillarSelector>
              <entitySelector>
                <entityClass>com.school.planner.domain.Lesson</entityClass>
              </entitySelector>
            </pillarSelector>
            <valueSelector variableName="timeslot"/>
          </pillarChangeMoveSelector>
          <pillarSwapMoveSelector>
            <fixedProbabilityWeight>1.0</fixedProbabilityWeight>
            <pillarSelector>
              <entitySelector>
                <entityClass>com.school.planner.domain.Lesson</entityClass>
              </entitySelector>
            </pillarSelector>
            <variableNameIncludes>
              <variableNameInclude>timeslot</variableNameInclude>
            </variableNameIncludes>
          </pillarSwapMoveSelector>
          <changeMoveSelector>
            <fixedProbabilityWeight>2.0</fixedProbabilityWeight>
            <entitySelector>
              <entityClass>com.school.planner.domain.Lesson</entityClass>
            </entitySelector>
            <valueSelector variableName="room"/>
          </changeMoveSelector>
          <pillarChangeMoveSelector>
            <fixedProbabilityWeight>0.5</fixedProbabilityWeight>
            <pillarSelector>
              <entitySelector>
                <entityClass>com.school.planner.domain.Lesson</entityClass>
              </entitySelector>
            </pillarSelector>
            <valueSelector variableName="room"/>
          </pillarChangeMoveSelector>
        </unionMoveSelector>
        <acceptor>
          <entityTabuSize>5</entityTabuSize>
        </acceptor>
        <forager>
          <acceptedCountLimit>1000</acceptedCountLimit>
        </forager>
      </localSearch>
    </solver>
  </solverBenchmark>

