<?xml version="1.0" encoding="UTF-8"?>
<plannerBenchmark xmlns="https://timefold.ai/xsd/benchmark">
  <!--
    acceptedCountLimit (forager) sensitivity benchmark - TASK-296 screen.

    Single-variable: every variant is the SAME local search (the production-matching
    Tabu-Entity-Size7: union change/pillar timeslot+room moves, entityTabuSize 7) and
    differs ONLY in the forager <acceptedCountLimit>. Isolates the forager's
    exploration-vs-exploitation knob (TASK-296 hypothesis: greedy acceptance, low limit,
    does more steps in fixed time and may beat 1000 for compactness/room).

    NOTE: the benchmark runs a FIRST_FIT CH + one combined LS (timeslot+room together),
    NOT the staged production pipeline. So this is a controlled LS-metaheuristic screen
    (relative comparison), not an absolute staged-solve KPI. Consistent with the
    knob-sweep synthesis: the lever class is the metaheuristic, not the medium weights.

    Budget: 600s secondsSpentLimit + 300s unimproved (a screen; the production benchmark
    uses 1800s/600s). 4 configs ~ 40 min.

    Companion: claudedocs/spalmone-2026-27/VERDICT-acceptedcountlimit-sweep.md
  -->
  <benchmarkDirectory>local/benchmarkReport</benchmarkDirectory>

  <inheritedSolverBenchmark>
    <solver>
      <solutionClass>com.school.planner.domain.SchoolSchedule</solutionClass>
      <entityClass>com.school.planner.domain.Lesson</entityClass>
      <scoreDirectorFactory>
        <constraintProviderClass>com.school.planner.solver.SchoolScheduleConstraintProvider</constraintProviderClass>
        <initializingScoreTrend>ONLY_DOWN</initializingScoreTrend>
      </scoreDirectorFactory>
      <termination>
        <secondsSpentLimit>600</secondsSpentLimit>
        <unimprovedSecondsSpentLimit>300</unimprovedSecondsSpentLimit>
      </termination>
      <constructionHeuristic>
        <constructionHeuristicType>FIRST_FIT</constructionHeuristicType>
      </constructionHeuristic>
    </solver>
    <problemBenchmarks>
      <solutionFileIOClass>com.school.planner.benchmark.SchoolScheduleSolutionFileIO</solutionFileIOClass>
      <inputSolutionFile>local/data/schedule-production.json</inputSolutionFile>
    </problemBenchmarks>
  </inheritedSolverBenchmark>

  <!-- ACL 1000: baseline (current production forager) -->
  <solverBenchmark>
    <name>ACL-1000-baseline</name>
    <solver>
      <environmentMode>NON_REPRODUCIBLE</environmentMode>
      <localSearch>
        <unionMoveSelector>
          <changeMoveSelector><fixedProbabilityWeight>5.0</fixedProbabilityWeight><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector><valueSelector variableName="timeslot"/></changeMoveSelector>
          <pillarChangeMoveSelector><fixedProbabilityWeight>2.0</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><valueSelector variableName="timeslot"/></pillarChangeMoveSelector>
          <pillarSwapMoveSelector><fixedProbabilityWeight>1.0</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><variableNameIncludes><variableNameInclude>timeslot</variableNameInclude></variableNameIncludes></pillarSwapMoveSelector>
          <changeMoveSelector><fixedProbabilityWeight>2.0</fixedProbabilityWeight><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector><valueSelector variableName="room"/></changeMoveSelector>
          <pillarChangeMoveSelector><fixedProbabilityWeight>0.5</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><valueSelector variableName="room"/></pillarChangeMoveSelector>
        </unionMoveSelector>
        <acceptor><entityTabuSize>7</entityTabuSize></acceptor>
        <forager><acceptedCountLimit>1000</acceptedCountLimit></forager>
      </localSearch>
    </solver>
  </solverBenchmark>

  <!-- ACL 100: medium exploration -->
  <solverBenchmark>
    <name>ACL-100</name>
    <solver>
      <environmentMode>NON_REPRODUCIBLE</environmentMode>
      <localSearch>
        <unionMoveSelector>
          <changeMoveSelector><fixedProbabilityWeight>5.0</fixedProbabilityWeight><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector><valueSelector variableName="timeslot"/></changeMoveSelector>
          <pillarChangeMoveSelector><fixedProbabilityWeight>2.0</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><valueSelector variableName="timeslot"/></pillarChangeMoveSelector>
          <pillarSwapMoveSelector><fixedProbabilityWeight>1.0</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><variableNameIncludes><variableNameInclude>timeslot</variableNameInclude></variableNameIncludes></pillarSwapMoveSelector>
          <changeMoveSelector><fixedProbabilityWeight>2.0</fixedProbabilityWeight><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector><valueSelector variableName="room"/></changeMoveSelector>
          <pillarChangeMoveSelector><fixedProbabilityWeight>0.5</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><valueSelector variableName="room"/></pillarChangeMoveSelector>
        </unionMoveSelector>
        <acceptor><entityTabuSize>7</entityTabuSize></acceptor>
        <forager><acceptedCountLimit>100</acceptedCountLimit></forager>
      </localSearch>
    </solver>
  </solverBenchmark>

  <!-- ACL 4: low (TASK-296 references the old quality config's 4) -->
  <solverBenchmark>
    <name>ACL-4</name>
    <solver>
      <environmentMode>NON_REPRODUCIBLE</environmentMode>
      <localSearch>
        <unionMoveSelector>
          <changeMoveSelector><fixedProbabilityWeight>5.0</fixedProbabilityWeight><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector><valueSelector variableName="timeslot"/></changeMoveSelector>
          <pillarChangeMoveSelector><fixedProbabilityWeight>2.0</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><valueSelector variableName="timeslot"/></pillarChangeMoveSelector>
          <pillarSwapMoveSelector><fixedProbabilityWeight>1.0</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><variableNameIncludes><variableNameInclude>timeslot</variableNameInclude></variableNameIncludes></pillarSwapMoveSelector>
          <changeMoveSelector><fixedProbabilityWeight>2.0</fixedProbabilityWeight><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector><valueSelector variableName="room"/></changeMoveSelector>
          <pillarChangeMoveSelector><fixedProbabilityWeight>0.5</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><valueSelector variableName="room"/></pillarChangeMoveSelector>
        </unionMoveSelector>
        <acceptor><entityTabuSize>7</entityTabuSize></acceptor>
        <forager><acceptedCountLimit>4</acceptedCountLimit></forager>
      </localSearch>
    </solver>
  </solverBenchmark>

  <!-- ACL 1: greedy (TASK-296 hypothesis: first improving move, max steps/time) -->
  <solverBenchmark>
    <name>ACL-1-greedy</name>
    <solver>
      <environmentMode>NON_REPRODUCIBLE</environmentMode>
      <localSearch>
        <unionMoveSelector>
          <changeMoveSelector><fixedProbabilityWeight>5.0</fixedProbabilityWeight><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector><valueSelector variableName="timeslot"/></changeMoveSelector>
          <pillarChangeMoveSelector><fixedProbabilityWeight>2.0</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><valueSelector variableName="timeslot"/></pillarChangeMoveSelector>
          <pillarSwapMoveSelector><fixedProbabilityWeight>1.0</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><variableNameIncludes><variableNameInclude>timeslot</variableNameInclude></variableNameIncludes></pillarSwapMoveSelector>
          <changeMoveSelector><fixedProbabilityWeight>2.0</fixedProbabilityWeight><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector><valueSelector variableName="room"/></changeMoveSelector>
          <pillarChangeMoveSelector><fixedProbabilityWeight>0.5</fixedProbabilityWeight><pillarSelector><entitySelector><entityClass>com.school.planner.domain.Lesson</entityClass></entitySelector></pillarSelector><valueSelector variableName="room"/></pillarChangeMoveSelector>
        </unionMoveSelector>
        <acceptor><entityTabuSize>7</entityTabuSize></acceptor>
        <forager><acceptedCountLimit>1</acceptedCountLimit></forager>
      </localSearch>
    </solver>
  </solverBenchmark>
</plannerBenchmark>
